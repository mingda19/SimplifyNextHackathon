# =============================================================================
#  Pantry — single global .env.  Loaded by every service.
#
#  NO AWS CREDENTIALS LIVE HERE. They are resolved via AWS SSO from aws/config
#  and refreshed automatically. Run `make aws-login` once per ~12h session.
# =============================================================================

# ---- Postgres / inventory service (workstream 1) ----------------------------
POSTGRES_DB=simplifynext
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
# Docker Compose overrides the hostname with the internal `postgres` service name.
DATABASE_URL=postgresql+psycopg://simplifynext:simplifynext@localhost:5432/simplifynext
INVENTORY_PORT=8000
APP_ENV=development
LOG_LEVEL=INFO

# ---- orchestrator cost controls (plan.md §7) --------------------------------
# FAKE_LLM=1 is the default. Set to 0 ONLY when deliberately spending money.
FAKE_LLM=1
FAKE_SERVICES=1
# Hard stop: the ledger refuses the next call once session spend hits this.
MAX_SESSION_SPEND_USD=2.00

# ---- AWS (identity only — no secrets) ---------------------------------------
# Credentials come from SSO. `make aws-login` refreshes them; boto3 then renews
# them on its own for the life of the SSO session.
AWS_PROFILE=hackathon
AWS_REGION=ap-southeast-1
# Bedrock inference region. Defaults to AWS_REGION when unset.
# NOTE: the hackathon deck's troubleshooting slide says Bedrock must be
# us-east-1. Run `make check-bedrock` to see which region actually serves
# Claude on this account, then set this accordingly.
BEDROCK_REGION=ap-southeast-1

# bedrock-runtime InvokeModel needs the INFERENCE PROFILE id (us. prefix).
# Mantle is blocked by an org SCP explicit deny — see test.py.
MODEL_PREDICT=us.anthropic.claude-haiku-4-5-20251001-v1:0
MODEL_ADAPT=us.anthropic.claude-haiku-4-5-20251001-v1:0

# ---- upstream services (workstreams 1/2/3) ----------------------------------
INVENTORY_URL=http://localhost:8001
FEEDBACK_URL=http://localhost:8002
PRICING_URL=http://localhost:8003

MAX_ADAPT_RETRIES=3

# ---- price_forecaster (workstream 3) ----------------------------------------
# Directional-confidence gate. Below this the endpoint returns NEUTRAL.
# 0.60 is what the held-out data supports (~61% realised test accuracy at
# ~52% coverage). 0.70 was tried and abandoned: validation flattered it to 88%
# on 17 obs while test gave 40% on 5. See services/price_forecaster/README.md.
PRICE_CONFIDENCE_GATE=0.60

# ---- feedback service (workstream 2) -----------------------------------------
FEEDBACK_SERVICE_PORT=8002
# Same Bedrock model the orchestrator already has confirmed working on this
# account -- extraction reuses MODEL_PREDICT's tier rather than guessing at a
# different one blind. Override here if you want a stronger model for it.
MODEL_EXTRACT=anthropic.claude-haiku-4-5
MAX_TOKENS_EXTRACT=2048
# Layer 4 of the SKU matcher (LLM adjudication for terms layers 1-3 miss).
# Off by default -- the service must be able to demo with it switched off,
# and it's still gated behind FAKE_LLM regardless.
MATCHER_LLM_ADJUDICATION=false
