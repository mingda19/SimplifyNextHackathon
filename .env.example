POSTGRES_DB=simplifynext
POSTGRES_USER=simplifynext
POSTGRES_PASSWORD=simplifynext
POSTGRES_PORT=5432

# Used when running the API directly on the host. Docker Compose overrides the
# hostname with the internal `postgres` service name.
DATABASE_URL=postgresql+psycopg://simplifynext:simplifynext@localhost:5432/simplifynext
INVENTORY_PORT=8000
APP_ENV=development
LOG_LEVEL=INFO
