# =============================================================================
#  Pantry — single global .env.  Loaded by every service.
#
#  NO AWS CREDENTIALS LIVE HERE. They are resolved via AWS SSO from aws/config
#  and refreshed automatically. Run `make aws-login` once per ~12h session.
# =============================================================================

# ---- Postgres / inventory service (workstream 1) ----------------------------
POSTGRES_DB=simplifynext
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
# Docker Compose overrides the hostname with the internal `postgres` service name.
DATABASE_URL=postgresql+psycopg://simplifynext:simplifynext@localhost:5432/simplifynext
INVENTORY_PORT=8000
APP_ENV=development
LOG_LEVEL=INFO

# ---- orchestrator cost controls (plan.md §7) --------------------------------
# FAKE_LLM=1 is the default. Set to 0 ONLY when deliberately spending money.
FAKE_LLM=1
FAKE_SERVICES=1
# Hard stop: the ledger refuses the next call once session spend hits this.
MAX_SESSION_SPEND_USD=2.00

# ---- AWS (identity only — no secrets) ---------------------------------------
# Credentials come from SSO. `make aws-login` refreshes them; boto3 then renews
# them on its own for the life of the SSO session.
AWS_PROFILE=hackathon
AWS_REGION=ap-southeast-1
# Bedrock inference region. Defaults to AWS_REGION when unset.
# NOTE: the hackathon deck's troubleshooting slide says Bedrock must be
# us-east-1. Run `make check-bedrock` to see which region actually serves
# Claude on this account, then set this accordingly.
BEDROCK_REGION=ap-southeast-1

# Bedrock IDs take the `anthropic.` prefix. Do NOT use the 2024-era id from the
# AWS deck (anthropic.claude-3-haiku-20240307-v1:0).
MODEL_PREDICT=anthropic.claude-haiku-4-5
MODEL_ADAPT=anthropic.claude-haiku-4-5

# ---- upstream services (workstreams 1/2/3) ----------------------------------
INVENTORY_URL=http://localhost:8001
FEEDBACK_URL=http://localhost:8002
PRICING_URL=http://localhost:8003

MAX_ADAPT_RETRIES=3
